{
  "name": "trust-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && node tools/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:portal": "vitest run --project portal",
    "test:watch": "vitest",
    "test:db": "node tools/with-postgres.mjs vitest run --project db --project db-approle",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "dev": "node services/platform-api/src/main.ts",
    "migrate": "node tools/migrate.ts",
    "db:grants": "node tools/db-grants.ts",
    "db:check": "node tools/db-check.ts",
    "bootstrap:operator": "node tools/bootstrap-operator.ts",
    "provision:sierra": "node tools/provision-sierra-business.ts",
    "loadtest": "PG_FSYNC=on node tools/with-postgres.mjs node tools/loadtest/run.ts",
    "audit:deps": "npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-security": "^4.2.0",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.58.2",
    "prettier": "^3.0.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.0.0",
    "undici": "7.30.1",
    "vitest": "^5.0.3",
    "yaml": "^2.0.0"
  }
}
